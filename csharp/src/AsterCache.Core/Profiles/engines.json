{
  "engines": [
    {
      "name": "Unity",
      "detect": ["UnityPlayer.dll", "<name>_Data/globalgamemanagers"],
      "include": [
        { "glob": "<name>_Data/globalgamemanagers*" },
        { "glob": "<name>_Data/resources.assets" },
        { "glob": "<name>_Data/sharedassets0.assets*" },
        { "glob": "<name>_Data/level0*" },
        { "glob": "<name>_Data/Managed/*.dll" },
        { "glob": "<name>_Data/il2cpp_data/Metadata/global-metadata.dat" },
        { "glob": "MonoBleedingEdge/**/*.dll" },
        { "glob": "UnityPlayer.dll" }
      ]
    },
    {
      "name": "Unreal",
      "detect": ["<Game>/Content/Paks/*.pak", "<Game>/Content/Paks/*.utoc"],
      "include": [
        { "glob": "<Game>/Content/Paks/pakchunk0*.pak" },
        { "glob": "<Game>/Content/Paks/pakchunk0*.utoc" },
        { "glob": "<Game>/Content/Paks/pakchunk0*.ucas" },
        { "glob": "<Game>/Binaries/Win64/*.dll" },
        { "glob": "<Game>/Content/Paks/*.pak", "head_mib": 64, "tail_mib": 64 },
        { "glob": "<Game>/Content/Paks/*.utoc" },
        { "glob": "<Game>/Content/Paks/*.ucas", "head_mib": 64 }
      ]
    },
    {
      "name": "Source",
      "detect": ["**/*_dir.vpk"],
      "include": [
        { "glob": "**/*_dir.vpk" },
        { "glob": "bin/*.dll" }
      ]
    },
    {
      "name": "Riot",
      "detect": ["Game/DATA/FINAL/*.wad.client"],
      "include": [
        { "glob": "Game/DATA/FINAL/Global*.wad.client" },
        { "glob": "Game/DATA/FINAL/UI*.wad.client" },
        { "glob": "Game/DATA/FINAL/Maps/**/*.wad.client", "head_mib": 64 },
        { "glob": "Game/League of Legends.exe" },
        { "glob": "Game/*.dll" },
        { "glob": "LeagueClient/*.exe" },
        { "glob": "LeagueClient/*.dll" },
        { "glob": "Game/DATA/FINAL/Champions/**/*.wad.client", "head_mib": 64 }
      ]
    }
  ],
  "common": [
    { "glob": "{exe_dir}/*.dll" }
  ]
}
