<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- 게시(-r win-x64)할 때만 적용: 시작 때의 JIT 를 줄임 (콜드 시작에서 이득이 큼) -->
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <ApplicationIcon>..\AsterCache.Tray\Assets\aster.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="AsterCache.Tests" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.0" />
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.0.2" />
    <ProjectReference Include="..\AsterCache.Core\AsterCache.Core.csproj" />
    <ProjectReference Include="..\AsterCache.Windows\AsterCache.Windows.csproj" />
    <ProjectReference Include="..\AsterCache.Prefetch\AsterCache.Prefetch.csproj" />
    <ProjectReference Include="..\AsterCache.Tracer\AsterCache.Tracer.csproj" />
  </ItemGroup>
</Project>
