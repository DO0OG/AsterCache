<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
  </PropertyGroup>
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationIcon>Assets\aster.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="AsterCache.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.12" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.12" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.12" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.0" />
    <!-- Avalonia.Desktop 이 끌어오는 0.21.2 는 GHSA-xrw6-gwf8-vvr9 취약판이라 올려 고정. -->
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.21.3" />
    <ProjectReference Include="..\AsterCache.Core\AsterCache.Core.csproj" />
    <ProjectReference Include="..\AsterCache.Windows\AsterCache.Windows.csproj" />
    <ProjectReference Include="..\AsterCache.Service\AsterCache.Service.csproj" />
    <!-- 관리 창이 자식 프로세스로 부르는 aster.exe 를 트레이와 같은 폴더에 둠 -->
    <ProjectReference Include="..\AsterCache.Cli\AsterCache.Cli.csproj" />
  </ItemGroup>
</Project>
